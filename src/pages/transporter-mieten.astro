---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';

const TURNSTILE_SITE_KEY = import.meta.env.TURNSTILE_SITE_KEY ?? '0x4AAAAAAD16L1qOldSqyqeU';

const vehicles = [
  {
    id: 'ford-e-transit',
    type: 'elektro',
    name: 'Ford E-Transit L2H2',
    badge: 'Elektro',
    volume: '9,5 m³',
    payload: '950 kg',
    priceDay: 129,
    kmIncluded: 150,
    kmExtra: '0,35',
    image: '/images/transporter/landlogistik_ford_e_transit_2022_300dpi.jpg',
    note: 'Unaufgeladen zurückgebracht: €0,30/km wird nachverrechnet.',
    highlights: [
      'Leiser, emissionsfreier Stadtverkehr',
      '150 km Tageskilometer inkl.',
      'Ideal für tägliche Touren in Vorarlberg',
    ],
  },
  {
    id: 'ford-transit-diesel',
    type: 'diesel',
    name: 'Ford Transit L2H2',
    badge: 'Diesel',
    volume: '9 m³',
    payload: '670 kg',
    priceDay: 105,
    kmIncluded: 150,
    kmExtra: '0,45',
    image: '/images/transporter/landlogistik_ford_transit_hoeher_300dpi.jpg',
    note: 'Vollgetankt zurückbringen – sonst €2,50/km Nachverrechnung.',
    highlights: [
      'Zuverlässig für alle Strecken in Vorarlberg',
      '150 km Tageskilometer inkl.',
      'Vollgetankt zurückbringen',
    ],
  },
  {
    id: 'toyota-proace-max',
    type: 'diesel',
    name: 'Toyota Proace Max',
    badge: 'Diesel',
    volume: '11 m³',
    payload: '1.300 kg',
    priceDay: 135,
    kmIncluded: 150,
    kmExtra: '0,45',
    image: '/images/transporter/toyota_proace_max_landlogistik_300dpi.jpg',
    note: 'Vollgetankt zurückbringen – sonst €2,50/km Nachverrechnung.',
    highlights: [
      'Größtes Ladevolumen – ideal für Möbel & Maschinen',
      '150 km Tageskilometer inkl.',
      'Vollgetankt zurückbringen',
    ],
  },
];

const usps = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: 'Elektro: emissionsfrei unterwegs',
    text: 'Der Ford E-Transit fährt leise und ohne direkte Emissionen – ideal für Innenstädte und frühe Touren.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: 'Tagesmiete ab Dornbirn',
    text: 'Flexible Tagesmiete direkt aus Dornbirn – kein versteckter Depotzuschlag, keine Mindestmietdauer.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 .92h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>`,
    title: 'Echter Mensch, direkte Absprache',
    text: 'Kein Online-Buchungsportal mit Kleingedrucktem. Sie rufen an, wir klären alles direkt – auch kurzfristig.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Vollkasko inklusive',
    text: 'Alle Fahrzeuge sind vollkaskoversichert – Selbstbehalt auf Anfrage, optional reduzierbar.',
  },
];
---

<BaseLayout
  title="Transporter mieten Vorarlberg – Diesel & Elektro | Landlogistik Dornbirn"
  description="Transporter mieten in Vorarlberg – Diesel & Elektro ab €79/Tag. Elektro-Transporter voll geladen abholen, leer zurückbringen. Direkt aus Dornbirn, unkompliziert."
  canonical="https://landlogistik.at/transporter-mieten/"
  breadcrumbs={[
    { name: 'Startseite', url: 'https://landlogistik.at/' },
    { name: 'Transporter mieten', url: 'https://landlogistik.at/transporter-mieten/' },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "VehicleRental",
    "name": "Transporter mieten Vorarlberg",
    "description": "Kleintransporter mieten in Vorarlberg – Diesel & Elektro. Ford Transit, Ford E-Transit, Toyota Proace Max. Ab €105/Tag inkl. 150 km.",
    "provider": {
      "@type": "LocalBusiness",
      "@id": "https://landlogistik.at/#business",
      "name": "Landlogistik"
    },
    "areaServed": { "@type": "State", "name": "Vorarlberg" },
    "url": "https://landlogistik.at/transporter-mieten/",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Transporter-Flotte",
      "itemListElement": [
        {
          "@type": "Offer",
          "name": "Ford E-Transit L2H2 Elektro",
          "price": "129",
          "priceCurrency": "EUR",
          "description": "Elektro-Transporter, 950 kg Nutzlast, 9,5 m³, 150 km/Tag inkl."
        },
        {
          "@type": "Offer",
          "name": "Ford Transit L2H2 Diesel",
          "price": "105",
          "priceCurrency": "EUR",
          "description": "Diesel-Transporter, 670 kg Nutzlast, 9 m³, 150 km/Tag inkl."
        },
        {
          "@type": "Offer",
          "name": "Toyota Proace Max Diesel",
          "price": "135",
          "priceCurrency": "EUR",
          "description": "Großer Diesel-Transporter, 1.300 kg Nutzlast, 11 m³, 150 km/Tag inkl."
        }
      ]
    }
  })} />

  <!-- HERO -->
  <section class="hero-dark relative overflow-hidden pt-40 pb-28 md:pt-48 md:pb-36" aria-labelledby="miete-heading">
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute -top-1/4 -right-1/4 w-[600px] h-[600px] rounded-full bg-primary opacity-20 blur-3xl"></div>
      <div class="absolute -bottom-1/4 -left-1/4 w-[400px] h-[400px] rounded-full bg-accent opacity-10 blur-3xl"></div>
    </div>
    <div class="container relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="eyebrow text-[#81c784]">Transporter mieten Vorarlberg</span>
          <div class="divider bg-accent"></div>
          <h1 id="miete-heading" class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mt-2 mb-6 leading-tight">
            Transporter mieten –<br/><span class="text-[#a5d6a7]">Diesel & Elektro</span>
          </h1>
          <p class="text-lg sm:text-xl text-white/80 mb-8 max-w-xl leading-relaxed">
            Tagesmiete direkt aus Dornbirn. Elektro-Transporter kommen <strong class="text-white">vollgeladen</strong> –
            Sie geben ihn leer zurück. Kein Ladekarten-Chaos, kein Ladestopp.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="#fahrzeuge" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-warm transition-colors text-lg">
              Fahrzeuge ansehen
            </a>
            <a href="#anfrage" class="inline-flex items-center gap-2 px-8 py-4 text-white border-2 border-white/30 rounded-lg hover:border-white/60 hover:bg-white/10 transition-colors text-lg font-semibold">
              Direkt anfragen
            </a>
          </div>
        </div>
        <div class="hidden lg:flex items-center justify-center">
          <div class="w-full max-w-lg rounded-2xl overflow-hidden shadow-2xl flex h-72">
            <div class="flex-1 overflow-hidden">
              <img src="/images/transporter/landlogistik_ford_e_transit_2022_300dpi.jpg" alt="Ford E-Transit Elektro" class="w-full h-full object-cover scale-110" loading="eager" />
            </div>
            <div class="flex-1 overflow-hidden border-x-2 border-white/20">
              <img src="/images/transporter/landlogistik_ford_transit_hoeher_300dpi.jpg" alt="Ford Transit Diesel" class="w-full h-full object-cover scale-110" loading="eager" />
            </div>
            <div class="flex-1 overflow-hidden">
              <img src="/images/transporter/toyota_proace_max_landlogistik_300dpi.jpg" alt="Toyota Proace Max" class="w-full h-full object-cover scale-110" loading="eager" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- USPs -->
  <section class="section bg-warm" aria-label="Vorteile der Transporter-Miete">
    <div class="container">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {usps.map((u) => (
          <div class="bg-white rounded-2xl p-6 border border-border">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-4 mx-auto">
              <Fragment set:html={u.icon} />
            </div>
            <h3 class="font-display text-base font-bold text-dark mb-2 text-center">{u.title}</h3>
            <p class="text-sm text-muted leading-relaxed text-center">{u.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAHRZEUGE -->
  <section id="fahrzeuge" class="section bg-white" aria-labelledby="fahrzeuge-heading">
    <div class="container">
      <div class="text-center mb-10">
        <span class="eyebrow">Unsere Flotte</span>
        <div class="divider mx-auto"></div>
        <h2 id="fahrzeuge-heading" class="font-display text-3xl sm:text-4xl font-bold text-dark mt-2 mb-4">
          Fahrzeuge & Preise
        </h2>
        <p class="text-muted max-w-xl mx-auto mb-8">
          Alle Preise pro Tag (netto), inkl. der angegebenen Kilometer. Individuelle Angebote für Mehrtagsmieten auf Anfrage.
        </p>

        <!-- Filter -->
        <div class="inline-flex rounded-xl border border-border overflow-hidden" role="group" aria-label="Fahrzeugtyp filtern">
          <button
            class="filter-btn px-6 py-2.5 text-sm font-semibold transition-colors bg-primary text-white"
            data-filter="all"
          >Alle</button>
          <button
            class="filter-btn px-6 py-2.5 text-sm font-semibold transition-colors bg-white text-muted hover:bg-warm"
            data-filter="elektro"
          >
            <span class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              Elektro
            </span>
          </button>
          <button
            class="filter-btn px-6 py-2.5 text-sm font-semibold transition-colors bg-white text-muted hover:bg-warm"
            data-filter="diesel"
          >Diesel</button>
        </div>
      </div>

      <!-- 2h-Miete + Monatsmiete – zuerst -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">

        <!-- 2h-Miete Card -->
        <div class="rounded-2xl border-2 border-primary/30 bg-warm overflow-hidden hover:shadow-xl transition-shadow duration-300 flex flex-col">
          <div class="h-40 bg-gradient-to-br from-primary/15 to-accent/10 flex items-center justify-center gap-4">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class="text-primary opacity-70" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            <div class="text-center">
              <p class="font-display text-4xl font-bold text-primary">€59,90</p>
              <p class="text-xs text-muted font-medium">inkl. MwSt.</p>
            </div>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <div class="mb-4">
              <h3 class="font-display text-xl font-bold text-dark mb-1">2-Stunden-Miete</h3>
              <p class="text-sm text-muted">Schnell, unkompliziert, ohne Tagesmiete.</p>
            </div>
            <p class="text-muted text-sm leading-relaxed flex-1 mb-5">
              Perfekt für Transporte, die weniger als einen halben Tag dauern –
              Umzugsgut, Lieferungen, Abholungen. Elektro oder Diesel, je nach Verfügbarkeit.
            </p>
            <ul class="space-y-2 mb-6">
              {['Elektro oder Diesel – je nach Verfügbarkeit', 'Keine versteckten Kosten', 'Abholung direkt in Dornbirn'].map((h) => (
                <li class="flex items-start gap-2 text-sm text-muted">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {h}
                </li>
              ))}
            </ul>
            <a href="#anfrage" class="block w-full text-center px-5 py-3 bg-primary text-white font-semibold rounded-lg hover:bg-primary-dark transition-colors">
              2h-Miete anfragen
            </a>
          </div>
        </div>

        <!-- Monatsmiete Card -->
        <div class="rounded-2xl border-2 border-dashed border-primary/40 bg-warm overflow-hidden hover:shadow-xl transition-shadow duration-300 flex flex-col">
          <div class="h-40 bg-gradient-to-br from-primary/10 to-accent/10 flex items-center justify-center">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class="text-primary opacity-60" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-start justify-between mb-4">
              <h3 class="font-display text-xl font-bold text-dark">Monatsmiete</h3>
              <div class="text-right">
                <p class="font-display text-2xl font-bold text-primary">auf Anfrage</p>
                <p class="text-xs text-muted">/ Monat inkl. MwSt.</p>
              </div>
            </div>
            <p class="text-muted text-sm leading-relaxed flex-1 mb-5">
              Regelmäßiger Bedarf? Eine Monatsmiete lohnt sich ab einer gewissen Auslastung deutlich –
              und gibt Ihnen maximale Planungssicherheit ohne tägliche Disposition.
            </p>
            <ul class="space-y-2 mb-6">
              {['Fahrzeug steht täglich zur Verfügung', 'Kein Buchungsaufwand pro Tag', 'Individuelles Angebot je nach Fahrzeug & Laufzeit'].map((h) => (
                <li class="flex items-start gap-2 text-sm text-muted">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {h}
                </li>
              ))}
            </ul>
            <a href="#anfrage" class="block w-full text-center px-5 py-3 border-2 border-primary text-primary font-semibold rounded-lg hover:bg-primary hover:text-white transition-colors">
              Monatsmiete anfragen
            </a>
          </div>
        </div>

      </div>

      <!-- Fahrzeuge (Tagesmiete) -->
      <div id="vehicle-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {vehicles.map((v) => (
          <div
            class="vehicle-card rounded-2xl border border-border overflow-hidden hover:shadow-xl transition-shadow duration-300 bg-white"
            data-type={v.type}
          >
            <div class="relative h-52 overflow-hidden bg-warm">
              <img
                src={v.image}
                alt={v.name}
                class="w-full h-full object-cover"
                loading="lazy"
                width="560"
                height="208"
              />
              <div class={`absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold ${v.type === 'elektro' ? 'bg-primary text-white' : 'bg-dark text-white'}`}>
                {v.badge}
              </div>
              <!-- Landlogistik branding overlay -->
              <div class="absolute bottom-0 left-0 right-0 bg-dark/70 backdrop-blur-sm px-3 py-1.5 flex items-center justify-between">
                <span class="text-xs text-white/80 font-medium">Mich kann man mieten</span>
                <span class="text-xs text-white font-semibold">+43 664 398 71 46 · landlogistik.at</span>
              </div>
            </div>
            <div class="p-6">
              <div class="flex items-start justify-between mb-4">
                <h3 class="font-display text-xl font-bold text-dark">{v.name}</h3>
                <div class="text-right">
                  <p class="font-display text-2xl font-bold text-primary">€{v.priceDay},-</p>
                  <p class="text-xs text-muted">/ Tag inkl. MwSt.</p>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-3 mb-5">
                <div class="bg-warm rounded-lg p-3 text-center">
                  <p class="font-bold text-dark text-sm">{v.volume}</p>
                  <p class="text-xs text-muted mt-0.5">Ladevolumen</p>
                </div>
                <div class="bg-warm rounded-lg p-3 text-center">
                  <p class="font-bold text-dark text-sm">{v.payload}</p>
                  <p class="text-xs text-muted mt-0.5">Nutzlast</p>
                </div>
                <div class="bg-warm rounded-lg p-3 text-center">
                  <p class="font-bold text-dark text-sm">{v.kmIncluded} km</p>
                  <p class="text-xs text-muted mt-0.5">inkl.</p>
                </div>
              </div>

              <ul class="space-y-2 mb-4">
                {v.highlights.map((h) => (
                  <li class="flex items-start gap-2 text-sm text-muted">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    {h}
                  </li>
                ))}
              </ul>
              {v.note && (
                <p class="text-xs text-muted bg-warm rounded-lg px-3 py-2 mb-4 border border-border">
                  ⚠ {v.note}
                </p>
              )}

              <a
                href="#anfrage"
                class="block w-full text-center px-5 py-3 bg-primary text-white font-semibold rounded-lg hover:bg-primary-dark transition-colors"
              >
                {v.name} anfragen
              </a>
            </div>
          </div>
        ))}

      </div>

      <div class="mt-6 text-center space-y-1">
        <p class="text-xs text-muted">
          Alle Preise inkl. MwSt. · 150 km Tageskilometer inkl. · Mehrkilometer: Elektro €0,35/km, Diesel €0,45/km
        </p>
        <p class="text-xs text-muted">
          Kaution bei allen Fahrzeugen: <strong class="text-dark">€250,- brutto</strong> · Mehrtagsangebote auf Anfrage
        </p>
      </div>
    </div>
  </section>

  <!-- ELEKTRO USP DARK SECTION – auskommentiert, ggf. später wieder aktivieren -->
  <!--
  <section class="section bg-dark text-white" aria-labelledby="elektro-heading">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="eyebrow text-[#81c784]">Elektro-Transporter</span>
          <div class="divider bg-accent"></div>
          <h2 id="elektro-heading" class="font-display text-3xl sm:text-4xl font-bold text-white mt-2 mb-6">
            Voll abholen.<br/>Leer zurückbringen.
          </h2>
          <p class="text-white/70 leading-relaxed mb-6">
            Elektro-Transporter mieten klingt manchmal kompliziert – Laden, Reichweite, Ladekarten.
            Bei uns nicht: Sie holen das Fahrzeug <strong class="text-white">vollgeladen</strong> ab
            und bringen es am Abend leer zurück. Fertig.
          </p>
          <ul class="space-y-4">
            {[
              '0 g CO₂ direkte Emissionen – ideal für Innenstadtzonen',
              'Leiser Betrieb – auch für frühe Touren in Vorarlberg',
              'Wird das Fahrzeug unaufgeladen zurückgebracht: €0,30/km Nachverrechnung',
              '150 km Tageskilometer inklusive',
            ].map((item) => (
              <li class="flex items-start gap-3 text-white/80">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#81c784] flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="grid grid-cols-1 gap-5">
          <img
            src="/images/transporter/landlogistik_ford_e_transit_2022_300dpi.jpg"
            alt="Ford E-Transit – Elektro-Transporter Landlogistik"
            width="560"
            height="360"
            class="w-full rounded-2xl object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
  -->

  <!-- ANFRAGE FORMULAR -->
  <section id="anfrage" class="section bg-warm" aria-labelledby="anfrage-heading">
    <div class="container-sm">
      <div class="text-center mb-10">
        <span class="eyebrow">Vermietung anfragen</span>
        <div class="divider mx-auto"></div>
        <h2 id="anfrage-heading" class="font-display text-3xl sm:text-4xl font-bold text-dark mt-2">
          Transporter anfragen
        </h2>
        <p class="mt-3 text-muted max-w-lg mx-auto">
          Kein Onlineportal, kein Kleingedrucktes. Füllen Sie das Formular aus – wir melden uns noch am selben Werktag.
        </p>
      </div>

      <!-- Success / Error banners -->
      <div id="tm-banner-success" class="alert-banner success mb-6" role="alert" aria-live="polite">
        <strong>Danke für Ihre Anfrage!</strong> Wir melden uns noch am selben Werktag bei Ihnen.
      </div>
      <div id="tm-banner-error" class="alert-banner error mb-6" role="alert" aria-live="polite">
