<!-- Cloudflare Turnstile script -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.getElementById('tm-form') as HTMLFormElement;
  const btn  = document.getElementById('tm-submit') as HTMLButtonElement;
  const ok   = document.getElementById('tm-banner-success') as HTMLElement;
  const err  = document.getElementById('tm-banner-error') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Wird gesendet…';
    ok.style.display = 'none';
    err.style.display = 'none';

    try {
      const res  = await fetch('/api/kontakt', { method: 'POST', body: new FormData(form) });
      const data = await res.json();
      if (data.ok) {
        ok.style.display = 'block';
        ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
        form.reset();
        if (window.turnstile) window.turnstile.reset();
      } else {
        err.style.display = 'block';
        err.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch {
      err.style.display = 'block';
      err.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } finally {
      btn.disabled = false;
      btn.textContent = 'Anfrage absenden';
    }
  });
</script>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.vehicle-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      buttons.forEach(b => {
        b.classList.remove('bg-primary', 'text-white');
        b.classList.add('bg-white', 'text-muted');
      });
      btn.classList.add('bg-primary', 'text-white');
      btn.classList.remove('bg-white', 'text-muted');

      cards.forEach(card => {
        const type = card.dataset.type ?? '';
        if (filter === 'all' || type === filter) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
